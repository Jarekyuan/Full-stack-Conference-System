# ============================================================================
# 全量 compose 的可选环境变量
# 用法：cp deploy/.env.example deploy/.env，然后按需修改
# deploy/.env 已被 .gitignore 忽略，不会进仓库；不要提交真实密钥
# ============================================================================

# ---- 宿主端口 ----
GATEWAY_PORT=8080
WEB_PORT=8000

# ---- 基础设施口令（生产必须改）----
MYSQL_ROOT_PASSWORD=root123
REDIS_PASSWORD=redis123
JWT_SECRET=smt-dev-secret-0123456789-abcdefghijklmnopqrstuv

# ---- 会议纪要：默认零依赖，开箱即用 ----
STORAGE_PROVIDER=local
# 浏览器访问地址；改 WEB_PORT 或远程部署时同步修改
MINUTES_LOCAL_BASE_URL=http://localhost:8000
MINUTES_ASR_PROVIDER=mock
MINUTES_AI_PROVIDER=mock

# ---- 真实云服务（按需取消注释并填写）----
# 注意：腾讯 ASR 需要能公网访问的音频 URL，因此真实 ASR 必须同时用 COS；
# 只用本地存储时请保持 MINUTES_ASR_PROVIDER=mock。
# STORAGE_PROVIDER=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-chengdu
# COS_BUCKET=
# MINUTES_ASR_PROVIDER=tencent
# TENCENT_ASR_SECRET_ID=
# TENCENT_ASR_SECRET_KEY=
# TENCENT_ASR_REGION=ap-chengdu
# MINUTES_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
