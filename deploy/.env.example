# ============================================================================
# 全量 compose 的可选环境变量
# 用法：cp deploy/.env.example deploy/.env，然后按需修改
# deploy/.env 已被 .gitignore 忽略，不会进仓库；不要提交真实密钥
# ============================================================================

# ---- 宿主端口 ----
# 默认只绑 127.0.0.1；局域网演示改成 0.0.0.0，并同时更换 JWT_SECRET 与 admin 密码
BIND_ADDR=127.0.0.1
GATEWAY_PORT=8080
WEB_PORT=8000

# ---- 基础设施口令（生产必须改）----
# ⚠️ MySQL 密码只在**首次初始化数据卷**时生效；已有卷改密码需 ALTER USER 或 down -v
MYSQL_ROOT_PASSWORD=root123
# 业务服务的 MySQL 账号（最小权限 DML）；mysql-init 每次 up 会确保存在并同步密码
DB_USER=smt_app
DB_PASSWORD=smt_app123
REDIS_PASSWORD=redis123
# RabbitMQ 用户同样只在首次初始化数据卷时创建；已有卷改用户需 rabbitmqctl
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# 对外/多人环境必须换成随机值：openssl rand -base64 32
JWT_SECRET=smt-dev-secret-0123456789-abcdefghijklmnopqrstuv

# ---- 会议纪要：默认零依赖，开箱即用 ----
STORAGE_PROVIDER=local
# 浏览器访问地址；改 WEB_PORT 或远程部署时同步修改
MINUTES_LOCAL_BASE_URL=http://localhost:8000
MINUTES_ASR_PROVIDER=mock
MINUTES_AI_PROVIDER=mock

# ---- 真实云服务（按需取消注释并填写）----
# 注意：腾讯 ASR 需要能公网访问的音频 URL，因此真实 ASR 必须同时用 COS；
# 只用本地存储时请保持 MINUTES_ASR_PROVIDER=mock。
# STORAGE_PROVIDER=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-chengdu
# COS_BUCKET=
# MINUTES_ASR_PROVIDER=tencent
# TENCENT_ASR_SECRET_ID=
# TENCENT_ASR_SECRET_KEY=
# TENCENT_ASR_REGION=ap-chengdu
# MINUTES_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
