<?xml version="1.0" encoding="UTF-8"?>
<!-- ==========================================================================
  meeting-common · 公共共享模块（T1.1）
  内容（后续任务填充）：Result/PageResult/ErrorCode/BusinessException/
  GlobalExceptionHandler（自动配置）/JwtUtil/UserContext
  设计原则：只放"稳定的小东西"；web/security 依赖设为 optional，不向服务传染
  ========================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smt</groupId>
        <artifactId>smt-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>meeting-common</artifactId>
    <name>meeting-common</name>
    <description>公共模块：统一响应 / 错误码 / 异常处理 / 用户上下文 / JWT 工具</description>

    <dependencies>
        <!-- Web 支撑（异常处理、Jackson 配置用；optional：由使用方自行引入 starter-web） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 参数校验（@Validated / 全局异常处理 MethodArgumentNotValidException） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          RabbitMQ（T4.3）：common 里的 `com.smt.common.mq` 包需要 amqp 的 Queue/Binding 类型。
          optional=true 的理由同 starter-web —— 只有 meeting-service / notification-service 用得到，
          不让 gateway / auth 被动引入一套 MQ 依赖（它们既不生产也不消费）。
          只用得到 amqp 的"声明模型"类型，不涉及连接：两个服务各自引 starter-amqp 提供连接与监听器。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Security 核心：UserHeaderFilter 桥接 SecurityContext + 方法级鉴权依赖 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- Spring Security 配置：@EnableMethodSecurity / @PreAuthorize 支持 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>

        <!-- Spring Security Web：SecurityFilterChain 支撑（config 中的 WebSecurityConfiguration 依赖它） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
        </dependency>

        <!-- 工具库 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
