<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 角色 SQL（手写 XML） -->
<mapper namespace="com.smt.auth.mapper.SysRoleMapper">

    <resultMap id="BaseResultMap" type="com.smt.auth.entity.SysRole">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, code, name, description, status, created_at, updated_at
    </sql>

    <!-- 用户角色 code：JOIN 到角色表，只取启用角色；命中 uk_user_role 最左前缀 -->
    <select id="selectCodesByUserId" resultType="java.lang.String">
        SELECT r.code
        FROM sys_role r
        JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{userId} AND r.status = 1
        ORDER BY r.id
    </select>

    <select id="selectIdsByUserId" resultType="java.lang.Long">
        SELECT role_id FROM sys_user_role WHERE user_id = #{userId}
    </select>

    <!-- 批量装配：一次查多用户的角色 code（分页列表用，避免逐行 N+1） -->
    <select id="selectCodesByUserIds" resultType="com.smt.auth.vo.UserRoleItem">
        SELECT ur.user_id AS userId, r.code AS code
        FROM sys_user_role ur
        JOIN sys_role r ON r.id = ur.role_id
        WHERE r.status = 1
          AND ur.user_id IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
        ORDER BY ur.user_id, r.id
    </select>

    <select id="selectAllEnabled" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_role
        WHERE status = 1
        ORDER BY id
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_role
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 批量绑定用户角色（多值 INSERT） -->
    <insert id="batchInsertUserRoles">
        INSERT INTO sys_user_role (user_id, role_id)
        VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

    <delete id="deleteUserRoles">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>

</mapper>
