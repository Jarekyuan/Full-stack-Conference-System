<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 用户表 SQL（手写：显式 resultMap + #{} 参数化，规范见 server/AI-RULES.md 第十一章） -->
<mapper namespace="com.smt.auth.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.smt.auth.entity.SysUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="dept_id" property="deptId"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, username, password, real_name, email, avatar, dept_id, status, created_at, updated_at
    </sql>

    <!-- 用户出参 VO 映射（分页用；deptName 由 LEFT JOIN 直出，roles 由 Service 批量装配） -->
    <resultMap id="UserVOMap" type="com.smt.auth.vo.UserVO">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="real_name" property="realName"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="dept_id" property="deptId"/>
        <result column="dept_name" property="deptName"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 按用户名查询：命中唯一索引 uk_username -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        WHERE username = #{username}
    </select>

    <!-- 按主键查询（命中主键索引） -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <!-- 批量按主键查询（IN + foreach；id 数量由上层限制 ≤100） -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 用户名/姓名模糊搜索 + 可选部门（选参会人/部门树选人，最多 50 条；左模糊无法走索引，用户量小可接受）。
         keyword 为空、deptId 有值 = 列该部门直属成员（T6.1）；两个条件都不传时 Service 已直接返回空数组。
         **只列启用用户**（T6.2）：停用账号不能登录，也不该被拉进新会议；历史参会记录不受影响。
         选参会人搜索（评审 P1-13）：只取 Picker 真正要用的三个字段（id/姓名/部门），
         不再 SELECT 整行再在 Service 里挑字段——少查字段、也彻底杜绝 email 这类 PII 顺带出去 -->
    <select id="searchBrief" resultType="com.smt.auth.vo.UserSearchVO">
        SELECT u.id AS id, u.real_name AS realName, d.name AS deptName
        FROM sys_user u
        LEFT JOIN sys_dept d ON d.id = u.dept_id
        <where>
            AND u.status = 1
            <if test="deptId != null">AND u.dept_id = #{deptId}</if>
            <if test="keyword != null and keyword != ''">
                AND (u.username LIKE CONCAT('%', #{keyword}, '%')
                OR u.real_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY u.id
        LIMIT 50
    </select>

    <!-- 部门条件：null = 全部；否则 IN (...)（includeChildren 的子树已在 Service 展开成 id 列表） -->
    <sql id="DeptCondition">
        <if test="deptIds != null">
            AND dept_id IN
            <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
                #{deptId}
            </foreach>
        </if>
    </sql>

    <!-- 用户总数（可按部门/子树筛选；命中 idx_dept） -->
    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM sys_user
        <where>
            <include refid="DeptCondition"/>
        </where>
    </select>

    <!-- 分页（手写 LIMIT；LEFT JOIN 部门直出 deptName；offset/size 由 Service 层规范化） -->
    <select id="selectPage" resultMap="UserVOMap">
        SELECT u.id, u.username, u.real_name, u.email, u.avatar, u.dept_id, u.status,
               d.name AS dept_name
        FROM sys_user u
        LEFT JOIN sys_dept d ON d.id = u.dept_id
        <where>
            <if test="deptIds != null">
                AND u.dept_id IN
                <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
                    #{deptId}
                </foreach>
            </if>
        </where>
        ORDER BY u.id
        LIMIT #{offset}, #{size}
    </select>

    <!-- 创建用户：自增主键回填 id（created_at/updated_at 走数据库默认值；dept_id 可空） -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, real_name, email, avatar, dept_id, status)
        VALUES (#{username}, #{password}, #{realName}, #{email}, #{avatar}, #{deptId}, #{status})
    </insert>

    <!-- 更新状态（updated_at 走 ON UPDATE CURRENT_TIMESTAMP） -->
    <update id="updateStatus">
        UPDATE sys_user
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <!-- 编辑资料（T1.20）：只改这三列——username/password 不出现在 SQL 里，杜绝"顺手改掉" -->
    <update id="updateProfile">
        UPDATE sys_user
        SET real_name = #{realName},
            email = #{email},
            dept_id = #{deptId}
        WHERE id = #{id}
    </update>

</mapper>
