<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 用户表 SQL（手写：显式 resultMap + #{} 参数化，规范见 server/AI-RULES.md 第十一章） -->
<mapper namespace="com.smt.auth.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.smt.auth.entity.SysUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="role" property="role"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, username, password, real_name, email, avatar, role, status, created_at, updated_at
    </sql>

    <!-- 按用户名查询：命中唯一索引 uk_username -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        WHERE username = #{username}
    </select>

    <!-- 按主键查询（命中主键索引） -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <!-- 批量按主键查询（IN + foreach；id 数量由上层限制 ≤100） -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 用户名/姓名模糊搜索（选参会人场景，最多 20 条；左模糊无法走索引，用户量小可接受） -->
    <select id="searchByKeyword" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        WHERE username LIKE CONCAT('%', #{keyword}, '%')
           OR real_name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY id
        LIMIT 20
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM sys_user
    </select>

    <!-- 分页（手写 LIMIT；offset/size 由 Service 层规范化） -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_user
        ORDER BY id
        LIMIT #{offset}, #{size}
    </select>

    <!-- 创建用户：自增主键回填 id（created_at/updated_at 走数据库默认值） -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, real_name, email, avatar, role, status)
        VALUES (#{username}, #{password}, #{realName}, #{email}, #{avatar}, #{role}, #{status})
    </insert>

    <!-- 更新状态（updated_at 走 ON UPDATE CURRENT_TIMESTAMP） -->
    <update id="updateStatus">
        UPDATE sys_user
        SET status = #{status}
        WHERE id = #{id}
    </update>

</mapper>
