<?xml version="1.0" encoding="UTF-8"?>
<!-- ==========================================================================
  meeting-service · 会议核心服务（T1.13）
  职责：会议室 / 预约 / 审批 / 状态机 / 定时任务（T1.14 起）
  数据访问：手写 MyBatis XML 为主（规范见 server/AI-RULES.md 第十一章）
  ========================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smt</groupId>
        <artifactId>smt-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>meeting-service</artifactId>
    <name>meeting-service</name>
    <description>会议核心服务：会议室 / 预约 / 审批 / 状态机</description>

    <dependencies>
        <!-- 共享库（Result/ErrorCode/JwtUtil/UserContext + 自动配置） -->
        <dependency>
            <groupId>com.smt</groupId>
            <artifactId>meeting-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web（Servlet 栈） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          RabbitMQ（T4.1：领域事件 → MQ）。
          用 spring-boot-starter-amqp（Spring AMQP）而不是手撸 amqp-client：
          连接管理/重连、消息转换器、@RabbitListener 都由 Boot 自动配置接管。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- 参数校验（@Valid） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP（T2.5 幂等切面 @Idempotent） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          Redisson 核心库（T2.6 分布式锁）。
          刻意不用 redisson-spring-boot-starter：后者会接管 Spring Data Redis 的连接工厂，
          影响现有 StringRedisTemplate（Lettuce）行为；职责隔离——锁用 Redisson，其余用 RedisTemplate。
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- Nacos 服务发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!--
          Nacos 配置中心（T4.8：限流阈值放这里，改值**不重启**即时生效——@RefreshScope 落地演示）。
          与 discovery 是两个 starter：一个是"服务在哪"，一个是"配置是什么"。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- OpenFeign（服务间调用）+ Resilience4j（fallback/circuitbreaker 支撑） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- 客户端负载均衡（Feign lb:// 服务发现调用必须） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 数据访问：MyBatis-Plus starter（含 MyBatis 核心；SQL 手写 XML 为主） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis（日历缓存 / 幂等 / 限流，M2-M4 使用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          Spring Cache（T4.7：会议室列表/详情缓存用注解式，日历缓存手写——两者都用过才知道边界）。
          只加 spring-boot-starter-cache（缓存抽象），Redis 实现由 starter-data-redis 提供。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 接口文档（Swagger UI；版本由父 POM 统一管理） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- 腾讯云 COS（会议纪要音频分片上传，M6） -->
        <dependency>
            <groupId>com.qcloud</groupId>
            <artifactId>cos_api</artifactId>
            <version>5.6.283</version>
        </dependency>

        <!-- 腾讯云录音文件识别（M6.7：上传音频后自动转写） -->
        <dependency>
            <groupId>com.tencentcloudapi</groupId>
            <artifactId>tencentcloud-sdk-java-asr</artifactId>
            <version>3.1.1288</version>
        </dependency>

        <!-- Word 导出（会议纪要 docx，M6） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
