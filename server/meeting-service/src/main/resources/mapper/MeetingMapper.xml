<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 会议主表 SQL（手写 XML） -->
<mapper namespace="com.smt.meeting.mapper.MeetingMapper">

    <resultMap id="BaseResultMap" type="com.smt.meeting.entity.Meeting">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="room_id" property="roomId"/>
        <result column="organiser_id" property="organiserId"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="cancel_reason" property="cancelReason"/>
        <result column="cancel_time" property="cancelTime"/>
        <result column="recurring_id" property="recurringId"/>
        <result column="version" property="version"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, title, room_id, organiser_id, start_time, end_time, status,
        remark, cancel_reason, cancel_time, recurring_id, version, created_at, updated_at
    </sql>

    <!-- 按主键查询：命中主键，走 PRIMARY -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM meeting
        WHERE id = #{id}
    </select>

    <!-- 审批用悲观锁（T3.2/T3.3）：锁住这一行，让"复检 → 迁移 → 写审批记录"对外不可穿插；
         命中主键 → 单行记录锁（非表锁）。锁序：若同时要锁会议室行，必须先锁会议室行 -->
    <select id="selectByIdForUpdate" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM meeting
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <!--
      CAS 状态更新：WHERE 带前态条件（status = #{fromStatus}），影响 0 行 = 状态已被并发变更。
      updated_at 由表定义的 ON UPDATE CURRENT_TIMESTAMP 自动刷新，无需显式 SET。
    -->
    <update id="updateStatus">
        UPDATE meeting
        SET status = #{toStatus}
        WHERE id = #{id} AND status = #{fromStatus}
    </update>

    <!-- 新增会议：created_at/updated_at 走数据库默认值；version 走默认 0 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO meeting (title, room_id, organiser_id, start_time, end_time, status, remark, recurring_id)
        VALUES (#{title}, #{roomId}, #{organiserId}, #{startTime}, #{endTime}, #{status}, #{remark}, #{recurringId})
    </insert>

    <!-- 冲突会议简报（JOIN sys_user 直出组织人名；同库只读展示字段） -->
    <resultMap id="ConflictVOMap" type="com.smt.meeting.vo.MeetingConflictVO">
        <id column="meeting_id" property="meetingId"/>
        <result column="title" property="title"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="organiser_id" property="organiserId"/>
        <result column="organiser_name" property="organiserName"/>
    </resultMap>

    <!--
      冲突检测核心查询（对照 docs/03 4.1）：
        room_id 等值 + start_time 范围 → 命中 idx_room_time（type=range）；
        半开区间判重：existing.start < scanEnd AND existing.end > scanStart
        （相邻时段如 10:00-11:00 与 11:00-12:00 不冲突，因为 11:00 > 11:00 为假）
      status IN (20,30)：占用时段的状态（R-4：10 待审批不占用）
    -->
    <select id="selectConflicts" resultMap="ConflictVOMap">
        SELECT m.id AS meeting_id, m.title, m.start_time, m.end_time,
               m.organiser_id, u.real_name AS organiser_name
        FROM meeting m
        LEFT JOIN sys_user u ON u.id = m.organiser_id
        WHERE m.room_id = #{roomId}
          AND m.status IN (20, 30)
          AND m.start_time &lt; #{scanEnd}
          AND m.end_time &gt; #{scanStart}
        <if test="excludeMeetingId != null">
            AND m.id != #{excludeMeetingId}
        </if>
        ORDER BY m.start_time
    </select>

    <!-- 日历条目（含 status 供前端按状态配色） -->
    <resultMap id="CalendarVOMap" type="com.smt.meeting.vo.CalendarMeetingVO">
        <id column="meeting_id" property="meetingId"/>
        <result column="title" property="title"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="organiser_id" property="organiserId"/>
        <result column="organiser_name" property="organiserName"/>
    </resultMap>

    <!--
      日历查询：按"开始时间落在本周"归属（跨天会议归到开始那天，前端无需处理跨天拆分）。
      范围条件 start_time >= ? AND start_time < ? 命中 idx_room_time 的 start_time 范围扫描。
      只取 10/20/30：日历展示有效日程，40/50/60 是历史态。
    -->
    <select id="selectByRoomAndRange" resultMap="CalendarVOMap">
        SELECT m.id AS meeting_id, m.title, m.start_time, m.end_time, m.status,
               m.organiser_id, u.real_name AS organiser_name
        FROM meeting m
        LEFT JOIN sys_user u ON u.id = m.organiser_id
        WHERE m.room_id = #{roomId}
          AND m.start_time &gt;= #{rangeStart}
          AND m.start_time &lt; #{rangeEnd}
          AND m.status IN (10, 20, 30)
        ORDER BY m.start_time
    </select>

    <!--
      列表查询条件（T2.8；<where> 自动处理 AND 前缀 + <choose>/<if> 组合）：
        scope：mine 限定"我组织的 或 我参与的"（EXISTS 半连接，避免 JOIN 去重）；
               all 不加归属条件（ADMIN/APPROVER 权限在 Service 层校验）★ choose 教学点
        statuses：多值 IN（<foreach>）；startDate/endDate 按开始时间过滤（endDate 含当天）
    -->
    <sql id="QueryConditions">
        <where>
            <choose>
                <when test="scope == 'mine'">
                    AND (m.organiser_id = #{userId}
                    OR EXISTS (SELECT 1 FROM meeting_participant mp
                    WHERE mp.meeting_id = m.id AND mp.user_id = #{userId}))
                </when>
                <otherwise>
                    <!-- scope = all：不加归属过滤 -->
                </otherwise>
            </choose>
            <if test="statuses != null and statuses.size() > 0">                AND m.status IN
                <foreach collection="statuses" item="s" open="(" separator="," close=")">#{s}</foreach>
            </if>
            <if test="roomId != null">AND m.room_id = #{roomId}</if>
            <if test="startDate != null">AND m.start_time &gt;= #{startDate}</if>
            <if test="endDate != null">AND m.start_time &lt; DATE_ADD(#{endDate}, INTERVAL 1 DAY)</if>
            <if test="keyword != null and keyword != ''">AND m.title LIKE CONCAT('%', #{keyword}, '%')</if>
        </where>
    </sql>

    <!-- 列表 VO（join 直出展示字段；participantCount 子查询统计） -->
    <resultMap id="MeetingVOMap" type="com.smt.meeting.vo.MeetingVO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="room_id" property="roomId"/>
        <result column="room_name" property="roomName"/>
        <result column="organiser_id" property="organiserId"/>
        <result column="organiser_name" property="organiserName"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="need_approval" property="needApproval"/>
        <result column="participant_count" property="participantCount"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 列表（手写分页 LIMIT；按开始时间倒序，"最近的在前面"） -->
    <select id="selectPage" resultMap="MeetingVOMap">
        SELECT m.id, m.title, m.room_id, r.name AS room_name,
               m.organiser_id, u.real_name AS organiser_name,
               m.start_time, m.end_time, m.status,
               s.need_approval,
               (SELECT COUNT(*) FROM meeting_participant mp2 WHERE mp2.meeting_id = m.id) AS participant_count,
               m.created_at
        FROM meeting m
        LEFT JOIN meeting_room r ON r.id = m.room_id
        LEFT JOIN sys_user u ON u.id = m.organiser_id
        LEFT JOIN room_strategy s ON s.room_id = m.room_id
        <include refid="QueryConditions"/>
        ORDER BY m.start_time DESC, m.id DESC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 独立 COUNT（不 JOIN：条件仅涉及 meeting 表） -->
    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        FROM meeting m
        <include refid="QueryConditions"/>
    </select>

    <!-- 待审批列表（T3.1）：固定 status=10，按开始时间升序（最早要开的先批） -->
    <resultMap id="ApprovalVOMap" type="com.smt.meeting.vo.ApprovalVO">
        <result column="meeting_id" property="meetingId"/>
        <result column="title" property="title"/>
        <result column="room_id" property="roomId"/>
        <result column="room_name" property="roomName"/>
        <result column="organiser_id" property="organiserId"/>
        <result column="organiser_name" property="organiserName"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectPendingPage" resultMap="ApprovalVOMap">
        SELECT m.id AS meeting_id, m.title, m.room_id, r.name AS room_name,
               m.organiser_id, u.real_name AS organiser_name,
               m.start_time, m.end_time, m.remark, m.created_at
        FROM meeting m
        LEFT JOIN meeting_room r ON r.id = m.room_id
        LEFT JOIN sys_user u ON u.id = m.organiser_id
        WHERE m.status = 10
        ORDER BY m.start_time, m.id
        LIMIT #{offset}, #{size}
    </select>

    <select id="countPending" resultType="long">
        SELECT COUNT(*)
        FROM meeting
        WHERE status = 10
    </select>

    <!-- 延长会议（T3.4）：只动 end_time 与 version，WHERE 双条件兜住并发（version）与状态漂移（status） -->
    <update id="updateEndTime">
        UPDATE meeting
        SET end_time = #{endTime},
            version = version + 1,
            updated_at = NOW()
        WHERE id = #{id}
          AND version = #{version}
          AND status = #{expectedStatus}
    </update>

    <!-- 下一场占用会议的开始时间（R-15：延长终点 ≤ 下一场开始 − 锁定缓冲）：
         口径与 selectConflicts 一致（20/30 为占用态），排除自身；无下一场 → 返回 NULL -->
    <select id="selectNextMeetingStart" resultType="java.time.LocalDateTime">
        SELECT MIN(start_time)
        FROM meeting
        WHERE room_id = #{roomId}
          AND status IN (20, 30)
          AND start_time &gt;= #{after}
          <if test="excludeMeetingId != null">AND id &lt;&gt; #{excludeMeetingId}</if>
    </select>

    <!-- 定时任务扫描（T3.5）：到点该开始 / 该结束的会议 id。
         时间用 DB 的 NOW()（docs/03 4.2 的既有写法），配合 idx_status_start / idx_status_end 走 range 扫描；
         LIMIT 由调用方给（分批处理，单批不放大事务） -->
    <select id="selectIdsToStart" resultType="long">
        SELECT id
        FROM meeting
        WHERE status = 20
          AND start_time &lt;= NOW()
        ORDER BY start_time
        LIMIT #{limit}
    </select>

    <select id="selectIdsToFinish" resultType="long">
        SELECT id
        FROM meeting
        WHERE status IN (20, 30)
          AND end_time &lt;= NOW()
        ORDER BY end_time
        LIMIT #{limit}
    </select>

    <!-- 对账扫描（T3.6 / E-4）：把时间条件从"到点"放宽到"过了 2 小时还没动"。
         2 小时的用意：正常轮询每分钟一次，任何 2 小时都没被推进的记录都不是"慢"，是"卡住了"；
         阈值也给得足够宽，不会和"刚刚才到点、正常任务正在处理"的记录抢同一行 -->
    <select id="selectStuckIdsToStart" resultType="long">
        SELECT id
        FROM meeting
        WHERE status = 20
          AND start_time &lt;= NOW() - INTERVAL 2 HOUR
        ORDER BY start_time
        LIMIT #{limit}
    </select>

    <select id="selectStuckIdsToFinish" resultType="long">
        SELECT id
        FROM meeting
        WHERE status IN (20, 30)
          AND end_time &lt;= NOW() - INTERVAL 2 HOUR
        ORDER BY end_time
        LIMIT #{limit}
    </select>

    <!-- 待审批超时（T3.6 / E-4）：10 既不占时段、也不被任何自动流转覆盖 -->
    <select id="selectStuckPending" resultType="long">
        SELECT id
        FROM meeting
        WHERE status = 10
          AND end_time &lt;= NOW()
        ORDER BY end_time
        LIMIT #{limit}
    </select>

    <!-- 详情 VO（全字段 + 展示冗余；participants/logs 由 Service 另行装配） -->
    <resultMap id="MeetingDetailMap" type="com.smt.meeting.vo.MeetingDetailVO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="room_id" property="roomId"/>
        <result column="room_name" property="roomName"/>
        <result column="organiser_id" property="organiserId"/>
        <result column="organiser_name" property="organiserName"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="cancel_reason" property="cancelReason"/>
        <result column="cancel_time" property="cancelTime"/>
        <result column="recurring_id" property="recurringId"/>
        <result column="version" property="version"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectDetailById" resultMap="MeetingDetailMap">
        SELECT m.id, m.title, m.room_id, r.name AS room_name,
               m.organiser_id, u.real_name AS organiser_name,
               m.start_time, m.end_time, m.status, m.remark,
               m.cancel_reason, m.cancel_time, m.recurring_id, m.version, m.created_at
        FROM meeting m
        LEFT JOIN meeting_room r ON r.id = m.room_id
        LEFT JOIN sys_user u ON u.id = m.organiser_id
        WHERE m.id = #{id}
    </select>

    <!-- 写取消信息（T2.9）：取消原因 + 取消时间（NOW()）；状态变更本身走状态机 CAS -->
    <update id="updateCancelInfo">
        UPDATE meeting
        SET cancel_reason = #{reason}, cancel_time = NOW()
        WHERE id = #{id}
    </update>

    <!--
      乐观锁更新（T2.10）：WHERE version=#{version} 校验并发，影响 0 行 = 已被他人修改。
      只改非状态字段 + version 自增；status 变更（R-14 回退）单独走状态机保证日志一致。
    -->
    <!-- 乐观锁更新：version 防"同一行的并发改"，status 防"改期与取消的交叉写"（后者只改 status、
         version 不动，单靠 version 拦不住 → 已取消的会议会被改期，见评审 C4） -->
    <update id="updateWithVersion">
        UPDATE meeting
        SET title = #{title}, room_id = #{roomId},
            start_time = #{startTime}, end_time = #{endTime}, remark = #{remark},
            version = version + 1
        WHERE id = #{id} AND version = #{version} AND status = #{expectedStatus}
    </update>

</mapper>
