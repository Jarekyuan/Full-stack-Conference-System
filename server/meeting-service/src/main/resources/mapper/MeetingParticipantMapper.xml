<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 会议参会人 SQL（手写 XML；N:N 中间表，v1.3 起不区分外部参会人） -->
<mapper namespace="com.smt.meeting.mapper.MeetingParticipantMapper">

    <resultMap id="BaseResultMap" type="com.smt.meeting.entity.MeetingParticipant">
        <id column="id" property="id"/>
        <result column="meeting_id" property="meetingId"/>
        <result column="user_id" property="userId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 批量新增：<foreach> 拼多值 VALUES，一次往返写完全部参会人（避免 N+1 次 insert） -->
    <insert id="batchInsert">
        INSERT INTO meeting_participant (meeting_id, user_id)
        VALUES
        <foreach collection="list" item="p" separator=",">
            (#{p.meetingId}, #{p.userId})
        </foreach>
    </insert>

    <!-- 按会议查询：命中 uk_meeting_user 最左前缀 (meeting_id) -->
    <select id="selectByMeetingId" resultMap="BaseResultMap">
        SELECT id, meeting_id, user_id, created_at
        FROM meeting_participant
        WHERE meeting_id = #{meetingId}
        ORDER BY id
    </select>

    <!-- 参会人明细（T2.8 详情）：JOIN sys_user 直出姓名/邮箱 -->
    <resultMap id="ParticipantVOMap" type="com.smt.meeting.vo.MeetingDetailVO$ParticipantVO">
        <result column="user_id" property="userId"/>
        <result column="real_name" property="realName"/>
        <result column="email" property="email"/>
    </resultMap>

    <select id="selectDetailByMeetingId" resultMap="ParticipantVOMap">
        SELECT mp.user_id, u.real_name, u.email
        FROM meeting_participant mp
        JOIN sys_user u ON u.id = mp.user_id
        WHERE mp.meeting_id = #{meetingId}
        ORDER BY mp.id
    </select>

</mapper>
