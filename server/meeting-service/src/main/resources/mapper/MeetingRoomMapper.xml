<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 会议室 SQL（手写 XML；JSON 列 images/device_tags 经自定义 JsonTypeHandler 解析） -->
<mapper namespace="com.smt.meeting.mapper.MeetingRoomMapper">

    <resultMap id="BaseResultMap" type="com.smt.meeting.entity.MeetingRoom">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="group_id" property="groupId"/>
        <result column="capacity" property="capacity"/>
        <result column="location" property="location"/>
        <result column="images" property="images"
                typeHandler="com.smt.meeting.handler.JsonTypeHandler"/>
        <result column="device_tags" property="deviceTags"
                typeHandler="com.smt.meeting.handler.JsonTypeHandler"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, name, group_id, capacity, location, images, device_tags, status, created_at, updated_at
    </sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM meeting_room
        ORDER BY group_id, id
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM meeting_room
        WHERE id = #{id}
    </select>

    <!-- 联查 VO（列表/详情共用）：会议室 + 分组名 + 策略，一次查询避免 N+1 -->
    <resultMap id="RoomVOMap" type="com.smt.meeting.vo.RoomVO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="group_id" property="groupId"/>
        <result column="group_name" property="groupName"/>
        <result column="capacity" property="capacity"/>
        <result column="location" property="location"/>
        <result column="images" property="images"
                typeHandler="com.smt.meeting.handler.JsonTypeHandler"/>
        <result column="device_tags" property="deviceTags"
                typeHandler="com.smt.meeting.handler.JsonTypeHandler"/>
        <result column="status" property="status"/>
        <result column="need_approval" property="needApproval"/>
        <result column="advance_days" property="advanceDays"/>
        <result column="max_duration_minutes" property="maxDurationMinutes"/>
        <result column="cancel_deadline_minutes" property="cancelDeadlineMinutes"/>
        <result column="buffer_minutes" property="bufferMinutes"/>
        <result column="allow_recurring" property="allowRecurring"/>
    </resultMap>

    <sql id="RoomVOColumns">
        r.id, r.name, r.group_id, g.name AS group_name, r.capacity, r.location,
        r.images, r.device_tags, r.status,
        s.need_approval, s.advance_days, s.max_duration_minutes,
        s.cancel_deadline_minutes, s.buffer_minutes, s.allow_recurring
    </sql>

    <!-- 列表：动态筛选（capacity 为下限语义，走 idx 全表小数据直接排序） -->
    <select id="selectList" resultMap="RoomVOMap">
        SELECT <include refid="RoomVOColumns"/>
        FROM meeting_room r
        LEFT JOIN room_group g ON g.id = r.group_id
        LEFT JOIN room_strategy s ON s.room_id = r.id
        <where>
            <if test="groupId != null">AND r.group_id = #{groupId}</if>
            <if test="capacity != null">AND r.capacity &gt;= #{capacity}</if>
            <if test="status != null">AND r.status = #{status}</if>
        </where>
        ORDER BY r.group_id, r.id
    </select>

    <!-- 详情：同联查，命中主键 -->
    <select id="selectDetailById" resultMap="RoomVOMap">
        SELECT <include refid="RoomVOColumns"/>
        FROM meeting_room r
        LEFT JOIN room_group g ON g.id = r.group_id
        LEFT JOIN room_strategy s ON s.room_id = r.id
        WHERE r.id = #{id}
    </select>

    <!-- 新增（JSON 列经 typeHandler 写入；created_at/updated_at 走数据库默认值） -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO meeting_room (name, group_id, capacity, location, images, device_tags, status)
        VALUES (#{name}, #{groupId}, #{capacity}, #{location},
                #{images, typeHandler=com.smt.meeting.handler.JsonTypeHandler},
                #{deviceTags, typeHandler=com.smt.meeting.handler.JsonTypeHandler},
                #{status})
    </insert>

    <!-- 更新（动态 set：仅更新非空字段） -->
    <update id="update">
        UPDATE meeting_room
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="groupId != null">group_id = #{groupId},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="location != null">location = #{location},</if>
            <if test="images != null">images = #{images, typeHandler=com.smt.meeting.handler.JsonTypeHandler},</if>
            <if test="deviceTags != null">device_tags = #{deviceTags, typeHandler=com.smt.meeting.handler.JsonTypeHandler},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM meeting_room WHERE id = #{id}
    </delete>

    <!-- 未结束会议统计：10 待审批/20 已预约/30 进行中 均视为占用（40/50/60 为终态） -->
    <select id="countActiveMeetingsByRoom" resultType="long">
        SELECT COUNT(*)
        FROM meeting
        WHERE room_id = #{roomId}
          AND status IN (10, 20, 30)
    </select>

</mapper>
